    {
      "parameters": {
        "jsCode": "const facturas = $input.all();\nconst hoy = new Date();\n\nconst resultado = facturas.map(item => {\n  const f = item.json;\n  \n  const partes = f.fecha_vencimiento.split('/');\n  const fechaVencimiento = new Date(partes[2], partes[1] - 1, partes[0]);\n  \n  const diasRetraso = Math.floor((hoy - fechaVencimiento) / (1000 * 60 * 60 * 24));\n  \n  let tipoRecordatorio = 'ninguno';\n  if (diasRetraso >= 30) tipoRecordatorio = 'urgente';\n  else if (diasRetraso >= 15) tipoRecordatorio = 'firme';\n  else if (diasRetraso >= 1) tipoRecordatorio = 'amable';\n\n  return {\n    json: {\n      numero_factura: f.numero_factura,\n      cliente: f.cliente,\n      email_cliente: f.email_cliente,\n      importe: f.importe,\n      fecha_vencimiento: f.fecha_vencimiento,\n      diasRetraso,\n      tipoRecordatorio\n    }\n  };\n});\n\nreturn resultado;"
      },
